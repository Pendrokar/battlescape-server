		<xs:complexType>
			<xs:attribute name="Key" type="StringExpr" />
			<xs:attribute name="Value" type="StringExpr" />
			<xs:attributeGroup ref="ArgPlaceholders" />
		</xs:complexType>
	</xs:element>

	<xs:element name="SaveToDB">
