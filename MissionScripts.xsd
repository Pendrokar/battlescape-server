				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="DisplayName" type="StringExpr" />
			<xs:attribute name="Group" type="StringExpr" />
			<xs:attribute name="Loadout" type="StringExpr" />
			<xs:attribute name="AI" type="BoolExpr" />
			<xs:attribute name="IndicatorFlags" type="IndicatorFlags" />
			<xs:attribute name="Skin" type="StringExpr" />
