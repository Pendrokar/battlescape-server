	<xs:complexType name="EmptyAction">
		<xs:attributeGroup ref="ArgPlaceholders" />
	</xs:complexType>

	<xs:complexType name="ReservedAction">
		<xs:annotation>
			<xs:documentation>Accepted by the runtime but currently inactive (Appendix B).</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax" />
		</xs:sequence>
		<xs:attributeGroup ref="ArgPlaceholders" />
		<xs:anyAttribute processContents="lax" />
	</xs:complexType>

	<!-- ========== Mission root ========== -->

	<xs:element name="Mission">
		<xs:complexType>
			<xs:choice minOccurs="0" maxOccurs="unbounded">
				<xs:element ref="EntryPoint" />
				<xs:element ref="StringsPath" />
				<xs:element ref="GameMode" />
				<xs:group ref="ScriptStatement" />
			</xs:choice>
			<xs:attribute name="ID" type="IntegerExpr">
				<xs:annotation>
					<xs:documentation>Menu sort order (lower first).</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="Category" type="MissionCategory" />
			<xs:attribute name="Image" type="StringExpr" />
			<xs:attribute name="Title" type="StringExpr" />
			<xs:attribute name="Descr" type="StringExpr" />
			<xs:attribute name="Tags" type="StringExpr" />
			<xs:attribute name="GameMode" type="GameModeValue" />
			<xs:attribute name="Icon" type="StringExpr" />
			<xs:attribute name="EstTime" type="StringExpr" />
			<xs:attribute name="IsOptional" type="Boolish" />
			<xs:attribute name="ReqDBState" type="StringExpr" />
			<xs:attribute name="CompDBState" type="StringExpr" />
			<xs:attribute name="Hidden" type="Boolish">
				<xs:annotation>
					<xs:documentation>true hides the mission entirely while it is locked.</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="IsLocked" type="Boolish" />
			<xs:attribute name="State" type="Boolish">
				<xs:annotation>
					<xs:documentation>false removes the mission from the menu (manual 1.3).</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attributeGroup ref="ArgPlaceholders" />
		</xs:complexType>
	</xs:element>

	<xs:element name="EntryPoint">
		<xs:annotation>
			<xs:documentation>Menu declaration. Default Start button is always Main. Produces Global.EntryPoint at run time.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:attribute name="Name" type="StringExpr" use="required" />
			<xs:attribute name="Text" type="StringExpr" />
			<xs:attribute name="ReqDBState" type="StringExpr" />
			<xs:attribute name="Hidden" type="Boolish" />
			<xs:attributeGroup ref="ArgPlaceholders" />
		</xs:complexType>
	</xs:element>

	<xs:element name="StringsPath">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:string">
					<xs:attribute name="Lang" type="LangCode" />
					<xs:attributeGroup ref="ArgPlaceholders" />
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>

	<xs:element name="GameMode">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:string">
					<xs:attributeGroup ref="ArgPlaceholders" />
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>

	<xs:element name="GenerateBattlescape">
		<xs:annotation>
			<xs:documentation>Manual 6.11. Size: Small, Medium, Large. Seed default 1234. NbBattlescapes default 1.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:attribute name="Size" type="BattlescapeSize" />
			<xs:attribute name="Seed" type="IntegerExpr" />
			<xs:attribute name="NbBattlescapes" type="IntegerExpr" />
			<xs:attribute name="NbBattles" type="IntegerExpr" />
			<xs:attributeGroup ref="ArgPlaceholders" />
		</xs:complexType>
	</xs:element>

	<xs:element name="GenerateMission">
		<xs:annotation>
			<xs:documentation>
				Manual 6.11. Type: 0 SpaceAssault, 1 LandAssault, 2 RogueBattle, 3 Kill, 4 Collect,
				5 Repair, 6 Nemesis, 7 Bounty, 8 Stranded, 9 Custom. State: 0 starting, 1 running, 2 ending.
			</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:attribute name="Target" type="StringExpr" />
			<xs:attribute name="Type" type="MissionGenType" />
			<xs:attribute name="State" type="MissionGenState" />
			<xs:attribute name="Objective" type="StringExpr" />
			<xs:attribute name="Team" type="IntegerExpr" />
			<xs:attribute name="Player" type="StringExpr" />
			<xs:attribute name="Difficulty" type="IntegerExpr" />
			<xs:attribute name="AutoStart" type="BoolExpr" />
			<xs:attribute name="AutoEnd" type="BoolExpr" />
			<xs:attribute name="Source" type="StringExpr" />
			<xs:attributeGroup ref="ArgPlaceholders" />
		</xs:complexType>
	</xs:element>

	<xs:element name="Include">
		<xs:annotation>
			<xs:documentation>Manual 5.8. $Current is the mission folder; $Dev is the game data folder.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:attribute name="Target" type="StringExpr" use="required" />
			<xs:attributeGroup ref="ArgPlaceholders" />
		</xs:complexType>
	</xs:element>

	<!-- ========== Named action blocks and control flow ========== -->

	<xs:element name="Actions">
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="ScriptBlock">
					<xs:attribute name="Name" type="StringExpr" />
					<xs:attribute name="Once" type="Boolish" />
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>

	<xs:element name="CreateTrigger">
		<xs:annotation>
			<xs:documentation>
				Manual 3 and 7. Common: Name, Type, Target (default Players), Once, AutoDelete, Unique.
				Type-specific: NewPlayers; Abilities; Actor, Module, Hardpoint; Angle; Range, X, Y, Z, Swap;
				Duration, StartTime; Events; Properties, Value; Waypoint; LeftN/CompN/RightN/AndN; MaxDamage (ignored).
			</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="ScriptBlock">
					<xs:attribute name="Name" type="StringExpr" />
					<xs:attribute name="Type" type="TriggerType" />
					<xs:attribute name="Target" type="StringExpr" />
					<xs:attribute name="Actor" type="StringExpr" />
					<xs:attribute name="Once" type="Boolish" />
					<xs:attribute name="Unique" type="Boolish" />
					<xs:attribute name="AutoDelete" type="Boolish" />
					<xs:attribute name="NewPlayers" type="Boolish" />
					<xs:attribute name="Swap" type="Boolish" />
					<xs:attribute name="Parent" type="StringExpr" />
					<xs:attribute name="Source" type="StringExpr" />
					<xs:attribute name="Value" type="StringExpr" />
					<xs:attribute name="Duration" type="NumberExpr" />
					<xs:attribute name="StartTime" type="NumberExpr" />
					<xs:attribute name="Range" type="NumberExpr" />
					<xs:attribute name="Angle" type="NumberExpr" />
					<xs:attribute name="Events" type="StringExpr" />
					<xs:attribute name="Properties" type="StringExpr" />
					<xs:attribute name="Waypoint" type="StringExpr" />
					<xs:attribute name="Hardpoint" type="IntegerExpr" />
					<xs:attribute name="Module" type="IntegerExpr" />
					<xs:attribute name="Abilities" type="StringExpr" />
					<xs:attribute name="MaxDamage" type="NumberExpr" />
					<xs:attributeGroup ref="ConditionTriple" />
					<xs:attributeGroup ref="XYZ" />
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>

	<xs:element name="Condition">
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="ScriptBlock">
					<xs:attributeGroup ref="ConditionTriple" />
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>

	<xs:element name="Else">
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="ScriptBlock" />
			</xs:complexContent>
		</xs:complexType>
	</xs:element>

	<xs:element name="Loop">
		<xs:annotation>
			<xs:documentation>Manual 5.3. Target is a collection or a counter value. Start default 0, Step default 1. Count required for a counter.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="ScriptBlock">
					<xs:attribute name="Count" type="IntegerExpr" />
					<xs:attribute name="Start" type="IntegerExpr" />
					<xs:attribute name="Step" type="IntegerExpr" />
					<xs:attribute name="Source" type="StringExpr" />
					<xs:attribute name="Target" type="StringExpr" />
					<xs:attribute name="Parallel" type="Boolish" />
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>

	<!-- ========== Empty / simple statements ========== -->

	<xs:element name="Break" type="EmptyAction" />
	<xs:element name="DeleteAllActors" type="EmptyAction" />
	<xs:element name="ResetEffects" type="EmptyAction" />
	<xs:element name="Restart" type="EmptyAction" />
	<xs:element name="StopAll" type="EmptyAction" />

	<!-- Appendix B: accepted, currently inactive -->
	<xs:element name="CloseDialog" type="ReservedAction" />
	<xs:element name="CreateActors" type="ReservedAction" />
	<xs:element name="CreateDialog" type="ReservedAction" />
	<xs:element name="CreateDialogButton" type="ReservedAction" />
	<xs:element name="CreateDialogImage" type="ReservedAction" />
	<xs:element name="CreateDialogText" type="ReservedAction" />
	<xs:element name="CreateSquad" type="ReservedAction" />
	<xs:element name="DestroySquad" type="ReservedAction" />
	<xs:element name="JoinSquad" type="ReservedAction" />
	<xs:element name="LeaveSquad" type="ReservedAction" />

