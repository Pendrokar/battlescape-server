			</xs:sequence>
			<xs:attribute name="Class" type="StringExpr" />
			<xs:attributeGroup ref="ArgPlaceholders" />
		</xs:complexType>
	</xs:element>

	<xs:element name="Body">
		<xs:complexType>
			<xs:choice minOccurs="0" maxOccurs="unbounded">
