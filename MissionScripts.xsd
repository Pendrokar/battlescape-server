			</xs:choice>
			<xs:attribute name="Class" type="StringExpr" />
			<xs:attributeGroup ref="ArgPlaceholders" />
		</xs:complexType>
	</xs:element>

	<xs:element name="Battlescape3">
		<xs:complexType>
			<xs:sequence>
