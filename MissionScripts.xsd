<?xml version="1.0" encoding="utf-8"?>
<!--
	MissionScripts.xsd
	Schema for Infinity Battlescape mission scripts.

	Primary source: MissionRuntimeUserManual.pdf (generated from the runtime codebase).
	Additional document roots (Loadout, Battlescapes, CServerNamePool) and a few
	corpus-only spellings are kept so existing XML under MissionScripts/ still validates.

	Document roots:
		- Mission                 Mission scripts (primary)
		- Loadout                 Ship loadout definitions
		- Battlescapes            Planetary / battlescape layouts
		- CServerNamePool         Server name pools
		- Actions / free-floating script statements (include fragments)

	Notes from the manual:
		- No XML namespace.
		- Action and argument names are case-insensitive at runtime; this schema is case-sensitive
		  and uses the canonical names from the manual.
		- Unknown action names are skipped and logged; unknown arguments are ignored.
		- Value arguments accept literals or expressions (Actor:..., Global.X, [0,1,0], ...).
		- Typed value arguments use BoolExpr / NumberExpr / IntegerExpr / VectorExpr (literal or expression).
		- Fixed arguments are literals read when the file is loaded (Boolish, enumerations, NumberLiteral).
		- Booleans: true/false (also 1/0). Comment="..." is a documented annotation convention.
		- Execute receives Arg1..Arg7 as Local.ArgN. Log substitutes $(Arg1)..$(Arg8).
		- Conditions have up to 16 LeftN/CompN/RightN/AndN segments.
		- Appendix B names are accepted by the runtime but currently inactive.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified" attributeFormDefault="unqualified">

	<!-- ========== Primitive / helper types ========== -->

	<xs:simpleType name="StringExpr">
		<xs:annotation>
			<xs:documentation>Literal or runtime expression (e.g. Player.Speed, Actor:Name.Position, [0,1,0], Local.Arg1).</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string" />
	</xs:simpleType>

	<xs:simpleType name="Boolish">
		<xs:annotation>
			<xs:documentation>Boolean token. Manual: true/false, also 1/0. True/False appear in some scripts.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="true" />
			<xs:enumeration value="false" />
			<xs:enumeration value="True" />
			<xs:enumeration value="False" />
			<xs:enumeration value="1" />
			<xs:enumeration value="0" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="ComparisonOp">
		<xs:annotation>
			<xs:documentation>
				Manual 5.4: Equal (default), NotEqual, Lower, LowerEqual, Higher, HigherEqual, In, NotIn.
				Unknown names fall back to Equal, so Equals works. Greater appears in some scripts.
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="Equal" />
			<xs:enumeration value="Equals" />
			<xs:enumeration value="NotEqual" />
			<xs:enumeration value="Lower" />
			<xs:enumeration value="LowerEqual" />
			<xs:enumeration value="Higher" />
			<xs:enumeration value="HigherEqual" />
			<xs:enumeration value="Greater" />
			<xs:enumeration value="In" />
			<xs:enumeration value="NotIn" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="TriggerType">
		<xs:annotation>
			<xs:documentation>
				Manual chapter 7. Reserved names (Appendix B) are accepted but never raised at present.
				PlayerDespawn appears in some scripts; the documented type is PlayerUndeploy.
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="ActorAimAt" />
			<xs:enumeration value="ActorCollision" />
			<xs:enumeration value="ActorCreated" />
			<xs:enumeration value="ActorDamaged" />
			<xs:enumeration value="ActorDestroyed" />
			<xs:enumeration value="ActorLookAt" />
			<xs:enumeration value="ActorProperty" />
			<xs:enumeration value="ActorRange" />
			<xs:enumeration value="ActorRepaired" />
			<xs:enumeration value="ActorStartAbility" />
			<xs:enumeration value="ActorStopAbility" />
			<xs:enumeration value="ActorWaypoint" />
			<xs:enumeration value="Condition" />
			<xs:enumeration value="DialogButton" />
			<xs:enumeration value="DialogClose" />
			<xs:enumeration value="GlobalProperty" />
			<xs:enumeration value="PlayerCollision" />
			<xs:enumeration value="PlayerDamaged" />
			<xs:enumeration value="PlayerDeath" />
			<xs:enumeration value="PlayerDeployed" />
			<xs:enumeration value="PlayerDespawn" />
			<xs:enumeration value="PlayerEvent" />
			<xs:enumeration value="PlayerJoin" />
			<xs:enumeration value="PlayerLeave" />
			<xs:enumeration value="PlayerProperty" />
			<xs:enumeration value="PlayerRange" />
			<xs:enumeration value="PlayerRepaired" />
			<xs:enumeration value="PlayerUndeploy" />
			<xs:enumeration value="PlayerWaypoint" />
			<xs:enumeration value="TargetSelected" />
			<xs:enumeration value="Timer" />
			<xs:enumeration value="ValueEquals" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="PlayerState">
		<xs:annotation>
			<xs:documentation>Manual 6.5 SetPlayerState: InGame, NonInteractive, Spawn, Spectator, plus Killcam and Walking.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="InGame" />
			<xs:enumeration value="NonInteractive" />
			<xs:enumeration value="Spawn" />
			<xs:enumeration value="Spectator" />
			<xs:enumeration value="Killcam" />
			<xs:enumeration value="Walking" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="GameModeValue">
		<xs:annotation>
			<xs:documentation>Manual 1.3: Custom (default), Assault, Sandbox, Freeflight, Conquest.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="Custom" />
			<xs:enumeration value="Assault" />
			<xs:enumeration value="Sandbox" />
			<xs:enumeration value="Freeflight" />
			<xs:enumeration value="Conquest" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="MissionCategory">
		<xs:annotation>
			<xs:documentation>Manual 1.3: Training, Workshop, Challenges or Campaign. Sandbox appears in some files.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="Training" />
			<xs:enumeration value="Workshop" />
			<xs:enumeration value="Challenges" />
			<xs:enumeration value="Campaign" />
			<xs:enumeration value="Sandbox" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="LangCode">
		<xs:restriction base="xs:string">
			<xs:enumeration value="de" />
			<xs:enumeration value="en" />
			<xs:enumeration value="es" />
			<xs:enumeration value="fr" />
			<xs:enumeration value="ru" />
			<xs:enumeration value="zh-CN" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="RotationType">
		<xs:annotation>
			<xs:documentation>Manual 6.2 SetRotation Type: Quaternion (X Y Z W), AxisAngle (axis X Y Z, angle W in radians), Euler.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="Quaternion" />
			<xs:enumeration value="AxisAngle" />
			<xs:enumeration value="Euler" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="NumberLiteral">
		<xs:annotation>
			<xs:documentation>Numeric literal: 3, -0.25, 1e3, 1.396. Empty is the same as omitting the argument.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="((-?([0-9]+(\.[0-9]*)?|\.[0-9]+)([eE][+-]?[0-9]+)?))?" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="IntegerLiteral">
		<xs:annotation>
			<xs:documentation>Whole-number literal, including negative (e.g. TeamID 255, -1). Empty is the same as omitting the argument.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="(-?[0-9]+)?" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="VectorLiteral">
		<xs:annotation>
			<xs:documentation>Vector literal [x, y, z] or [x, y, z, w] (manual 1.8).</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="\[[^\]]*\]" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="BoolExpr">
		<xs:annotation>
			<xs:documentation>
				Boolean value argument: true/false/1/0, or a value expression that evaluates to one
				(e.g. Local.Arg6). Manual 2.3: value arguments are evaluated each time the action runs.
				Use Boolish for fixed flags read when the file is loaded (Once, Wait, Parallel, ...).
			</xs:documentation>
		</xs:annotation>
		<xs:union memberTypes="Boolish StringExpr" />
	</xs:simpleType>

	<xs:simpleType name="NumberExpr">
		<xs:annotation>
			<xs:documentation>
				A number (seconds, km, degrees, scale, ...) or a value expression that evaluates to one
				(e.g. Global.Countdown, Player.Timer). Empty is the same as omitting the argument.
			</xs:documentation>
		</xs:annotation>
		<xs:union memberTypes="NumberLiteral StringExpr" />
	</xs:simpleType>

	<xs:simpleType name="IntegerExpr">
		<xs:annotation>
			<xs:documentation>
				A whole number or a value expression that evaluates to one (e.g. Local.Arg4, Global.MaxCount).
			</xs:documentation>
		</xs:annotation>
		<xs:union memberTypes="IntegerLiteral StringExpr" />
	</xs:simpleType>

	<xs:simpleType name="VectorExpr">
		<xs:annotation>
			<xs:documentation>
				A vector [x, y, z] / [x, y, z, w], or a value expression that evaluates to one
				(e.g. Player.Rotation, Actor:Name.Position, [0, 0, 1]).
			</xs:documentation>
		</xs:annotation>
		<xs:union memberTypes="VectorLiteral StringExpr" />
	</xs:simpleType>

	<xs:simpleType name="AIObjective">
		<xs:annotation>
			<xs:documentation>Manual 6.3 SetAIState Objective. Defense appears in scripts (PDF name: Defend).</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="Stranded" />
			<xs:enumeration value="Battle" />
			<xs:enumeration value="Bombard" />
			<xs:enumeration value="Path" />
			<xs:enumeration value="Retreat" />
			<xs:enumeration value="Defend" />
			<xs:enumeration value="Defense" />
			<xs:enumeration value="Waypoints" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="AIObjectiveExpr">
		<xs:union memberTypes="AIObjective StringExpr" />
	</xs:simpleType>

	<xs:simpleType name="AIBehavior">
		<xs:annotation>
			<xs:documentation>Manual 6.3 SetAIState Behavior.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="None" />
			<xs:enumeration value="RandomFlight" />
			<xs:enumeration value="Attack" />
			<xs:enumeration value="RandomHunt" />
			<xs:enumeration value="WarpIn" />
			<xs:enumeration value="WarpOut" />
			<xs:enumeration value="Debug" />
			<xs:enumeration value="Path" />
			<xs:enumeration value="Waypoints" />
			<xs:enumeration value="MissileFrenzy" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="AIBehaviorExpr">
		<xs:union memberTypes="AIBehavior StringExpr" />
	</xs:simpleType>

	<xs:simpleType name="AIPathMode">
		<xs:annotation>
			<xs:documentation>Manual 6.3 SetAIPath Mode (fixed): Sequential, Closest, SequentialClosest.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="Sequential" />
			<xs:enumeration value="Closest" />
			<xs:enumeration value="SequentialClosest" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="BattlescapeSize">
		<xs:annotation>
			<xs:documentation>Manual 6.11 GenerateBattlescape Size: Small, Medium, Large.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="Small" />
			<xs:enumeration value="Medium" />
			<xs:enumeration value="Large" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="MissionGenType">
		<xs:annotation>
			<xs:documentation>Manual 6.11 GenerateMission Type: 0 SpaceAssault, 1 LandAssault, 2 RogueBattle, 3 Kill, 4 Collect, 5 Repair, 6 Nemesis, 7 Bounty, 8 Stranded, 9 Custom.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="0" />
			<xs:enumeration value="1" />
			<xs:enumeration value="2" />
			<xs:enumeration value="3" />
			<xs:enumeration value="4" />
			<xs:enumeration value="5" />
			<xs:enumeration value="6" />
			<xs:enumeration value="7" />
			<xs:enumeration value="8" />
			<xs:enumeration value="9" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="MissionGenState">
		<xs:annotation>
			<xs:documentation>Manual 6.11 GenerateMission State: 0 starting, 1 running, 2 ending.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="0" />
			<xs:enumeration value="1" />
			<xs:enumeration value="2" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="MusicType">
		<xs:annotation>
			<xs:documentation>Manual Appendix A / 6.9 PlayMusic Type. Empty releases music to the game director.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="" />
			<xs:enumeration value="Menu" />
			<xs:enumeration value="Space_Ambient" />
			<xs:enumeration value="Space_Exploration" />
			<xs:enumeration value="Battle" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="NotificationCategory">
		<xs:annotation>
			<xs:documentation>Manual 6.5 SendNotification Category.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="Information" />
			<xs:enumeration value="Critical" />
			<xs:enumeration value="Chat" />
			<xs:enumeration value="Warning" />
			<xs:enumeration value="Squad" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="NotificationPriority">
		<xs:annotation>
			<xs:documentation>Manual 6.5 SendNotification Priority.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="None" />
			<xs:enumeration value="Info" />
			<xs:enumeration value="Low" />
			<xs:enumeration value="Medium" />
			<xs:enumeration value="High" />
			<xs:enumeration value="Critical" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="PopupCategory">
		<xs:annotation>
			<xs:documentation>Manual 6.5 SendPopup Category. Empty is neutral. Unkown appears in a shipped script.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="" />
			<xs:enumeration value="VictoryPopup" />
			<xs:enumeration value="DefeatPopup" />
			<xs:enumeration value="VictoryMatch" />
			<xs:enumeration value="DefeatMatch" />
			<xs:enumeration value="RankUp" />
			<xs:enumeration value="MissionSuccess" />
			<xs:enumeration value="MissionFailure" />
			<xs:enumeration value="Unkown" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="ObjectiveClass">
		<xs:annotation>
			<xs:documentation>Manual 6.6 AddObjective Class. Checkbox is not a class (it becomes a plain line) but appears in scripts.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="" />
			<xs:enumeration value="Text" />
			<xs:enumeration value="Title" />
			<xs:enumeration value="Primary" />
			<xs:enumeration value="Secondary" />
			<xs:enumeration value="Order" />
			<xs:enumeration value="ProgressBar" />
			<xs:enumeration value="Countdown" />
			<xs:enumeration value="Timer" />
			<xs:enumeration value="Checkbox" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="ObjectiveType">
		<xs:annotation>
			<xs:documentation>Manual 6.6 AddObjective Type. Scripts mostly drive lines with None; Timer appears in files.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="" />
			<xs:enumeration value="None" />
			<xs:enumeration value="FlyTo" />
			<xs:enumeration value="DestroyTarget" />
			<xs:enumeration value="DestroyTargets" />
			<xs:enumeration value="DestroyModulesByClass" />
			<xs:enumeration value="ProtectTarget" />
			<xs:enumeration value="ProtectTargets" />
			<xs:enumeration value="ProtectModulesByClass" />
			<xs:enumeration value="HackModule" />
			<xs:enumeration value="CollectItems" />
			<xs:enumeration value="StatusTarget" />
			<xs:enumeration value="RepairTarget" />
			<xs:enumeration value="RepairModulesByClass" />
			<xs:enumeration value="DetectHostilesInRange" />
			<xs:enumeration value="Timer" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="ObjectiveModule">
		<xs:annotation>
			<xs:documentation>Manual 6.6 AddObjective Module for the ...ByClass types.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="" />
			<xs:enumeration value="Unknown" />
			<xs:enumeration value="Defense" />
			<xs:enumeration value="OrbitalCanon" />
			<xs:enumeration value="CoreReactor" />
			<xs:enumeration value="SatPowerPlant" />
			<xs:enumeration value="CorePowerPlant" />
			<xs:enumeration value="WarpInterdiction" />
			<xs:enumeration value="ShieldGenerator" />
			<xs:enumeration value="HangarSpawn" />
			<xs:enumeration value="DockingSpawn" />
			<xs:enumeration value="SupplyBay" />
			<xs:enumeration value="Indestructible" />
			<xs:enumeration value="CarrierSpawn" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="HighlightState">
		<xs:annotation>
			<xs:documentation>Manual 6.5 Highlight State: the screen the element is on.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="None" />
			<xs:enumeration value="Map" />
			<xs:enumeration value="Ship" />
			<xs:enumeration value="Team" />
			<xs:enumeration value="Mission" />
			<xs:enumeration value="Social" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="MainMenu">
		<xs:annotation>
			<xs:documentation>Manual 5.9 Exit MainMenu.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="Training" />
			<xs:enumeration value="Workshop" />
			<xs:enumeration value="Challenges" />
			<xs:enumeration value="Campaign" />
			<xs:enumeration value="Sandbox" />
			<xs:enumeration value="Multiplayer" />
			<xs:enumeration value="ServerBrowser" />
			<xs:enumeration value="Root" />
			<xs:enumeration value="Options" />
			<xs:enumeration value="Credits" />
			<xs:enumeration value="None" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="IndicatorFlags">
		<xs:annotation>
			<xs:documentation>Manual 6.2 CreateActor IndicatorFlags. Empty for none.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="" />
			<xs:enumeration value="NamePermanent" />
		</xs:restriction>
	</xs:simpleType>

	<!-- ========== Common attribute groups ========== -->

	<xs:attributeGroup name="ArgPlaceholders">
		<xs:annotation>
			<xs:documentation>
				Arg1..Arg8: Execute passes Arg1..Arg7 as Local.ArgN (manual 5.1).
				Log substitutes $(Arg1)..$(Arg8) (manual 5.11).
				Comment is ignored by the runtime and is the documented way to annotate a line (manual 1.8).
			</xs:documentation>
		</xs:annotation>
		<xs:attribute name="Arg1" type="StringExpr" />
		<xs:attribute name="Arg2" type="StringExpr" />
		<xs:attribute name="Arg3" type="StringExpr" />
		<xs:attribute name="Arg4" type="StringExpr" />
		<xs:attribute name="Arg5" type="StringExpr" />
		<xs:attribute name="Arg6" type="StringExpr" />
		<xs:attribute name="Arg7" type="StringExpr" />
		<xs:attribute name="Arg8" type="StringExpr" />
		<xs:attribute name="Comment" type="StringExpr" />
	</xs:attributeGroup>

	<xs:attributeGroup name="TargetAttr">
		<xs:attribute name="Target" type="StringExpr" />
	</xs:attributeGroup>

	<xs:attributeGroup name="XYZ">
		<xs:attribute name="X" type="NumberExpr" />
		<xs:attribute name="Y" type="NumberExpr" />
		<xs:attribute name="Z" type="NumberExpr" />
	</xs:attributeGroup>

	<xs:attributeGroup name="Quat">
		<xs:attribute name="RX" type="NumberExpr" />
		<xs:attribute name="RY" type="NumberExpr" />
		<xs:attribute name="RZ" type="NumberExpr" />
		<xs:attribute name="RW" type="NumberExpr" />
	</xs:attributeGroup>

	<xs:attributeGroup name="LookXYZ">
		<xs:attribute name="LX" type="NumberExpr" />
		<xs:attribute name="LY" type="NumberExpr" />
		<xs:attribute name="LZ" type="NumberExpr" />
	</xs:attributeGroup>

	<xs:attributeGroup name="VelXYZ">
		<xs:attribute name="VX" type="NumberExpr" />
		<xs:attribute name="VY" type="NumberExpr" />
		<xs:attribute name="VZ" type="NumberExpr" />
	</xs:attributeGroup>

	<xs:attributeGroup name="SourceTarget">
		<xs:attribute name="Source" type="StringExpr" />
		<xs:attribute name="Target" type="StringExpr" />
	</xs:attributeGroup>

	<xs:attributeGroup name="BinaryValue">
		<xs:attribute name="Source1" type="StringExpr" />
		<xs:attribute name="Source2" type="StringExpr" />
		<xs:attribute name="Target" type="StringExpr" />
	</xs:attributeGroup>

	<xs:attributeGroup name="ConditionTriple">
		<xs:annotation>
			<xs:documentation>Manual 5.4: up to 16 segments. AndN="true" (default) chains with AND; AndN="false" chains with OR.</xs:documentation>
		</xs:annotation>
		<xs:attribute name="Left1" type="StringExpr" />
		<xs:attribute name="Comp1" type="ComparisonOp" />
		<xs:attribute name="Right1" type="StringExpr" />
		<xs:attribute name="And1" type="BoolExpr" />
		<xs:attribute name="Left2" type="StringExpr" />
		<xs:attribute name="Comp2" type="ComparisonOp" />
		<xs:attribute name="Right2" type="StringExpr" />
		<xs:attribute name="And2" type="BoolExpr" />
		<xs:attribute name="Left3" type="StringExpr" />
		<xs:attribute name="Comp3" type="ComparisonOp" />
		<xs:attribute name="Right3" type="StringExpr" />
		<xs:attribute name="And3" type="BoolExpr" />
		<xs:attribute name="Left4" type="StringExpr" />
		<xs:attribute name="Comp4" type="ComparisonOp" />
		<xs:attribute name="Right4" type="StringExpr" />
		<xs:attribute name="And4" type="BoolExpr" />
		<xs:attribute name="Left5" type="StringExpr" />
		<xs:attribute name="Comp5" type="ComparisonOp" />
