<Mission ID="907" Category="Workshop" Title="Test_07_Persistence" Descr="PDF 6.10 SaveToDB LoadFromDB and server settings" Tags="TEST" GameMode="Custom">
	<Include Target="$Current/Test_Assert.xml" />
	<SetValue Target="Global.FailCount" Source="0" />
	<Log Text="Test: $(Arg1) $(Arg2) $(Arg3)" Arg1="BEGIN" Arg2="Test_07_Persistence" Arg3="ok" />

	<CreateActor Name="PlayerActor" Class="Interceptor" TeamID="1" Loadout="Default" AI="false" />
	<SetPosition Target="PlayerActor" X="0" Y="0" Z="0" />

	<SaveToDB Key="MissionTest_PersistKey" Value="42" />
	<LoadFromDB Value="Global.Loaded" Key="MissionTest_PersistKey" />
	<Execute Target="AssertEqual" Arg1="LoadFromDB" Arg2="Global.Loaded" Arg3="42" />

	<LoadFromDB Value="Global.Missing" Key="MissionTest_NoSuchKey_ZZZ" />
	<Execute Target="AssertEqual" Arg1="LoadFromDB_missing" Arg2="Global.Missing" Arg3="0" />

	<SaveToDB Key="MissionTest_T1_State" Value="0" />
	<LoadFromDB Value="Global.T1_State" Key="MissionTest_T1_State" />
	<Execute Target="AssertEqual" Arg1="T1_State_before" Arg2="Global.T1_State" Arg3="0" />
	<Condition Left1="Global.T1_State" Comp1="Equal" Right1="0">
		<SaveToDB Key="MissionTest_T1_State" Value="1" />
	</Condition>
	<LoadFromDB Value="Global.T1_State2" Key="MissionTest_T1_State" />
	<Execute Target="AssertEqual" Arg1="T1_State_after" Arg2="Global.T1_State2" Arg3="1" />

	<SaveToDB Key="MissionTest_T1_State" Value="0" />
	<SaveToDB Key="MissionTest_PersistKey" Value="0" />

	<SetValue Target="Server.FrameTimeScale" Source="1" />
	<Execute Target="AssertEqual" Arg1="Server_FrameTimeScale" Arg2="Server.FrameTimeScale" Arg3="1" />

	<SetValue Target="Server.AllowSwitchTeam" Source="0" />
	<Execute Target="AssertEqual" Arg1="Server_AllowSwitchTeam" Arg2="Server.AllowSwitchTeam" Arg3="0" />

	<SetValue Target="Server.DamageScale" Source="1" />
	<Execute Target="AssertEqual" Arg1="Server_DamageScale" Arg2="Server.DamageScale" Arg3="1" />

	<SetValue Target="Server.MatchLoop" Source="0" />
	<Execute Target="AssertEqual" Arg1="Server_MatchLoop" Arg2="Server.MatchLoop" Arg3="0" />

	<SetValue Target="Server.AllowShipClass.0" Source="1" />
	<Execute Target="AssertEqual" Arg1="Server_AllowShipClass_0" Arg2="Server.AllowShipClass.0" Arg3="1" />

	<Execute Target="AssertDone" />
</Mission>
