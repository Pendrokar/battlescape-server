<Mission ID="905" Category="Workshop" Title="Test_05_Triggers" Descr="PDF ch.3 and ch.7 actor-side trigger examples" Tags="TEST" GameMode="Custom">
	<Include Target="$Current/Test_Assert.xml" />
	<SetValue Target="Global.FailCount" Source="0" />
	<Log Text="Test: $(Arg1) $(Arg2) $(Arg3)" Arg1="BEGIN" Arg2="Test_05_Triggers" Arg3="ok" />

	<CreateActor Name="PlayerActor" Class="Interceptor" TeamID="1" Loadout="Default" AI="false" />
	<SetPosition Target="PlayerActor" X="0" Y="0" Z="0" />
	<SetValue Target="Actor:PlayerActor.PowerState" Source="1" />
	<SetValue Target="Actor:PlayerActor.Direction" Source="[0, 0, 1]" />

	<SetValue Target="Global.CreatedBomber" Source="0" />
	<CreateTrigger Name="AnySpawned" Type="ActorCreated" Target="Actors">
		<Condition Left1="Actor.ActorClassName" Comp1="Equal" Right1="Bomber">
			<SetValue Target="Global.CreatedBomber" Source="1" />
		</Condition>
	</CreateTrigger>
	<CreateActor Name="SpawnedShip" Class="Bomber" TeamID="0" Loadout="None" AI="false" DisplayName="SpawnedShip" />
	<SetPosition Target="SpawnedShip" X="3" Y="0" Z="0" />

	<SetValue Target="Global.KillCount" Source="0" />
	<CreateTrigger Name="DroneDestroyed" Type="ActorDestroyed" Target="Actor:TestDrone">
		<AddValue Target="Global.KillCount" Source1="Global.KillCount" Source2="1" />
	</CreateTrigger>
	<CreateActor Name="TestDrone" Class="Interceptor" TeamID="0" Loadout="None" AI="false" />
	<SetPosition Target="TestDrone" X="5" Y="0" Z="0" />
	<KillActor Target="TestDrone" />

	<SetValue Target="Global.PowerTrigger" Source="0" />
	<CreateTrigger Name="PowerShipUp" Type="ActorProperty" Target="Actor:PlayerActor" Properties="PowerState" Value="0" Once="true">
		<SetValue Target="Global.PowerTrigger" Source="1" />
	</CreateTrigger>
	<SetValue Target="Actor:PlayerActor.PowerState" Source="0" />

	<SetValue Target="Global.HitPointsTrigger" Source="0" />
	<CreateTrigger Name="HitPointsChanged" Type="ActorProperty" Target="Actor:PlayerActor" Properties="HitPoints" Once="true">
		<SetValue Target="Global.HitPointsTrigger" Source="1" />
	</CreateTrigger>
	<SetValue Target="Actor:PlayerActor.HitPointsRatio" Source="0.25" />

	<SetValue Target="Global.TeamTrigger" Source="0" />
	<CreateTrigger Name="TeamChanged" Type="ActorProperty" Target="Actor:PlayerActor" Properties="TeamID" Value="0" Once="true">
		<SetValue Target="Global.TeamTrigger" Source="1" />
	</CreateTrigger>
	<SetValue Target="Actor:PlayerActor.TeamID" Source="0" />

	<SetValue Target="Global.StartTimeZero" Source="0" />
	<CreateTrigger Name="ImmediateTimer" Type="Timer" Target="Actor:PlayerActor" Duration="10" StartTime="0.0" Once="true">
		<SetValue Target="Global.StartTimeZero" Source="1" />
	</CreateTrigger>

	<SetValue Target="Global.TimerFired" Source="0" />
	<CreateTrigger Name="ActorTick" Type="Timer" Target="Actor:PlayerActor" Duration="0.4" Once="true" AutoDelete="true">
		<SetValue Target="Global.TimerFired" Source="1" />
	</CreateTrigger>

	<CreateActor Name="Outpost" Class="Marker" TeamID="255" DisplayName="Outpost" />
	<SetPosition Target="Outpost" X="0" Y="0" Z="0" />
	<CreateActor Name="Ranger" Group="Movers" Class="Interceptor" TeamID="1" Loadout="None" AI="false" />
	<SetPosition Target="Ranger" X="50" Y="0" Z="0" />
	<SetValue Target="Global.RangeEnter" Source="0" />
	<CreateTrigger Name="CloseToOutpost" Type="ActorRange" Target="Actors:Movers" Actor="Outpost" Range="2.0" Once="true">
		<SetValue Target="Global.RangeEnter" Source="1" />
	</CreateTrigger>
	<Wait Duration="0.3" />
	<SetPosition Target="Ranger" X="0.5" Y="0" Z="0" />

	<CreateActor Name="Leaver" Group="Leavers" Class="Interceptor" TeamID="1" Loadout="None" AI="false" />
	<SetPosition Target="Leaver" X="0.2" Y="0" Z="0" />
	<SetValue Target="Global.RangeLeave" Source="0" />
	<CreateTrigger Name="LeavingOutpost" Type="ActorRange" Target="Actors:Leavers" Actor="Outpost" Range="2.0" Swap="true" Once="true">
		<SetValue Target="Global.RangeLeave" Source="1" />
	</CreateTrigger>
	<Wait Duration="0.3" />
	<SetPosition Target="Leaver" X="20" Y="0" Z="0" />

	<CreateActor Name="LookTarget" Class="Marker" TeamID="255" DisplayName="LookTarget" />
	<SetPosition Target="LookTarget" X="0" Y="0" Z="10" />
	<SetValue Target="Actor:PlayerActor.Direction" Source="[1, 0, 0]" />
	<SetValue Target="Global.LookAt" Source="0" />
	<CreateTrigger Name="LookingAtMarker" Type="ActorLookAt" Target="Actors" Actor="LookTarget" Angle="15" Once="true">
		<SetValue Target="Global.LookAt" Source="1" />
	</CreateTrigger>
	<Wait Duration="0.3" />
	<SetValue Target="Actor:PlayerActor.Direction" Source="[0, 0, 1]" />

	<SetValue Target="Global.WaveDone" Source="0" />
	<CreateTrigger Name="WaveCompleted" Type="Condition" Target="Actor:PlayerActor" Left1="Global.WaveKills" Comp1="HigherEqual" Right1="3" Once="true">
		<SetValue Target="Global.WaveDone" Source="1" />
	</CreateTrigger>
	<SetValue Target="Global.WaveKills" Source="3" />

	<SetValue Target="Global.UniqueFired" Source="0" />
	<CreateTrigger Name="UniqueTick" Type="Timer" Target="Actor:PlayerActor" Duration="0.15" Once="true" Unique="true">
		<SetValue Target="Global.UniqueFired" Source="1" />
	</CreateTrigger>
	<CreateTrigger Name="UniqueTick" Type="Timer" Target="Actor:PlayerActor" Duration="0.15" Once="true" Unique="true">
		<SetValue Target="Global.UniqueFired" Source="2" />
	</CreateTrigger>

	<SetValue Target="Global.DeletedFired" Source="0" />
	<CreateTrigger Name="WillBeDeleted" Type="Timer" Target="Actor:PlayerActor" Duration="10" Once="true">
		<SetValue Target="Global.DeletedFired" Source="1" />
	</CreateTrigger>
	<DeleteTrigger Target="WillBeDeleted" />

	<SetValue Target="Global.ResetCount" Source="0" />
	<CreateTrigger Name="Resetable" Type="Condition" Target="Actor:PlayerActor" Left1="Global.ResetFlag" Comp1="Equal" Right1="1" Once="true">
		<AddValue Target="Global.ResetCount" Source1="Global.ResetCount" Source2="1" />
		<SetValue Target="Global.ResetFlag" Source="0" />
	</CreateTrigger>
	<SetValue Target="Global.ResetFlag" Source="1" />

	<Wait Duration="0.6" />
	<ResetTrigger Target="Resetable" />
	<SetValue Target="Global.ResetFlag" Source="1" />
	<Wait Duration="3.5" />

	<Execute Target="AssertEqual" Arg1="ActorCreated_Bomber" Arg2="Global.CreatedBomber" Arg3="1" />
	<Execute Target="AssertEqual" Arg1="ActorDestroyed_KillCount" Arg2="Global.KillCount" Arg3="1" />
	<Execute Target="AssertEqual" Arg1="ActorProperty_PowerState" Arg2="Global.PowerTrigger" Arg3="1" />
	<Execute Target="AssertEqual" Arg1="ActorProperty_HitPoints" Arg2="Global.HitPointsTrigger" Arg3="1" />
	<Execute Target="AssertEqual" Arg1="ActorProperty_TeamID" Arg2="Global.TeamTrigger" Arg3="1" />
	<Execute Target="AssertEqual" Arg1="Timer" Arg2="Global.TimerFired" Arg3="1" />
	<Execute Target="AssertEqual" Arg1="Timer_StartTimeZero" Arg2="Global.StartTimeZero" Arg3="1" />
	<Condition Left1="Global.RangeEnter" Comp1="Equal" Right1="1">
		<Execute Target="AssertEqual" Arg1="ActorRange_enter" Arg2="Global.RangeEnter" Arg3="1" />
	</Condition>
	<Else>
		<Execute Target="AssertSkipped" Arg1="ActorRange_enter" Arg2="requires_player" />
	</Else>
	<Condition Left1="Global.RangeLeave" Comp1="Equal" Right1="1">
		<Execute Target="AssertEqual" Arg1="ActorRange_leave" Arg2="Global.RangeLeave" Arg3="1" />
	</Condition>
	<Else>
		<Execute Target="AssertSkipped" Arg1="ActorRange_leave" Arg2="requires_player" />
	</Else>
	<Execute Target="AssertEqual" Arg1="ActorLookAt" Arg2="Global.LookAt" Arg3="1" />
	<Execute Target="AssertEqual" Arg1="ConditionTrigger" Arg2="Global.WaveDone" Arg3="1" />
	<Execute Target="AssertEqual" Arg1="Unique_keeps_first" Arg2="Global.UniqueFired" Arg3="1" />
	<Execute Target="AssertEqual" Arg1="DeleteTrigger_not_fired" Arg2="Global.DeletedFired" Arg3="0" />
	<Execute Target="AssertEqual" Arg1="ResetTrigger" Arg2="Global.ResetCount" Arg3="2" />

	<SetValue Target="Global.Interrupted" Source="0" />
	<CreateTrigger Name="SlowBody" Type="Timer" Target="Actor:PlayerActor" Duration="0.1" Once="true">
		<Wait Duration="1.5" />
		<SetValue Target="Global.Interrupted" Source="1" />
	</CreateTrigger>
	<Wait Duration="0.3" />
	<InterruptTrigger Target="SlowBody" />
	<Wait Duration="2" />
	<Execute Target="AssertEqual" Arg1="InterruptTrigger" Arg2="Global.Interrupted" Arg3="0" />

	<SetValue Target="Global.DeletedAll" Source="0" />
	<CreateTrigger Name="WillBeDeletedAll" Type="Timer" Target="Actor:PlayerActor" Duration="0.2" Once="true">
		<SetValue Target="Global.DeletedAll" Source="1" />
	</CreateTrigger>
	<DeleteAllTriggers />
	<Wait Duration="0.5" />
	<Execute Target="AssertEqual" Arg1="DeleteAllTriggers" Arg2="Global.DeletedAll" Arg3="0" />

	<Execute Target="AssertDone" />
</Mission>
