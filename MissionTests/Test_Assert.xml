<Actions Name="AssertEqual">
	<Condition Left1="Local.Arg2" Comp1="Equal" Right1="Local.Arg3">
		<Log Text="Test: $(Arg1) $(Arg2) $(Arg3)" Arg1="Local.Arg1" Arg2="Pass" Arg3="Local.Arg2" />
	</Condition>
	<Else>
		<Log Text="Test: $(Arg1) $(Arg2) $(Arg3)" Arg1="Local.Arg1" Arg2="Failure" Arg3="Local.Arg2" />
		<AddValue Target="Global.FailCount" Source1="Global.FailCount" Source2="1" />
	</Else>
</Actions>
