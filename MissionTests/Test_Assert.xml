<Actions Name="AssertDone">
	<Condition Left1="Global.FailCount" Comp1="Equal" Right1="0">
		<Log Text="Test: $(Arg1) $(Arg2) $(Arg3)" Arg1="COMPLETE" Arg2="Pass" Arg3="Global.FailCount" />
	</Condition>
	<Else>
		<Log Text="Test: $(Arg1) $(Arg2) $(Arg3)" Arg1="COMPLETE" Arg2="Failure" Arg3="Global.FailCount" />
	</Else>
</Actions>
