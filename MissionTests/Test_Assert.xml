<Actions Name="AssertNear">
	<SubValue Target="Local.Delta" Source1="Local.Arg2" Source2="Local.Arg3" />
	<AbsValue Target="Local.AbsDelta" Source="Local.Delta" />
	<Condition Left1="Local.AbsDelta" Comp1="LowerEqual" Right1="0.01">
		<Log Text="Test: $(Arg1) $(Arg2) $(Arg3)" Arg1="Local.Arg1" Arg2="Pass" Arg3="Local.Arg2" />
	</Condition>
	<Else>
